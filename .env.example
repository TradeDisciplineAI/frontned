# Environment Variables — AI Trading Copilot Frontend
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your values in .env.local
#   3. NEVER commit .env.local to git (it is already in .gitignore)
#
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# TypeScript types for these variables are defined in src/types/env.d.ts

# ─── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="AI Trading Copilot"
VITE_APP_ENV="development"       # development | staging | production

# ─── Backend API ───────────────────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:8000"
VITE_MARKET_API_BASE_URL="http://localhost:8001"
VITE_MARKET_WS_BASE_URL="ws://localhost:8001"
